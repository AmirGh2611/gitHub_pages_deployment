---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="DevOps & Systems Portfolio">
    <main class="container">
        <!-- Hero Section -->
        <section class="hero">
            <h1>Hi, I'm <span class="accent">Alex</span></h1>
            <p class="subtitle">DevOps Engineer & Infrastructure Enthusiast</p>
            <p class="bio">Building scalable systems, automating workflows, and securing cloud environments.</p>
            <a href="#projects" class="btn">View Projects</a>
        </section>

        <!-- Projects Section -->
        <section id="projects" class="section">
            <h2>Featured Projects</h2>
            <div class="grid">
                <div class="card">
                    <h3>Automated Log Archiver</h3>
                    <p>A CLI tool built in Bash to schedule, compress, and archive server logs seamlessly.</p>
                </div>
                <div class="card">
                    <h3>Kubernetes GitOps Pipeline</h3>
                    <p>Continuous deployment infrastructure leveraging ArgoCD, Terraform, and GitHub Actions.</p>
                </div>
                <div class="card">
                    <h3>Network Topology Simulator</h3>
                    <p>Simulating enterprise routing, subnetting, and failover architectures using Cisco Packet Tracer.</p>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    body {
        font-family: system-ui, -apple-system, sans-serif;
        background: #0f172a;
        color: #f8fafc;
        margin: 0;
        padding: 2rem;
    }
    .container { max-width: 800px; margin: 0 auto; }
    .hero { padding: 4rem 0; text-align: center; }
    .hero h1 { font-size: 3rem; margin-bottom: 0.5rem; }
    .accent { color: #38bdf8; }
    .subtitle { font-size: 1.25rem; color: #94a3b8; margin-bottom: 1rem; }
    .bio { color: #cbd5e1; margin-bottom: 2rem; }
    .btn { background: #38bdf8; color: #0f172a; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: bold; }
    .section { margin-top: 4rem; }
    .section h2 { border-bottom: 2px solid #334155; padding-bottom: 0.5rem; margin-bottom: 1.5rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
    .card { background: #1e293b; padding: 1.5rem; border-radius: 8px; border: 1px solid #334155; }
    .card h3 { margin-top: 0; color: #38bdf8; }
    .card p { color: #94a3b8; font-size: 0.95rem; }
</style>